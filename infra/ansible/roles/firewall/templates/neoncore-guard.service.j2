[Unit]
Description=NeonCore LAN guard (nftables table inet neoncore_guard)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target docker.service k3s.service
After=local-fs.target nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/neoncore/neoncore-guard.nft

[Install]
WantedBy=multi-user.target
